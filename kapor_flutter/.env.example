# Production backend. Copy this file to .env for a release build.
API_BASE_URL=https://api.domday.food/api

# OAuth 2.0 Web client ID used by the backend to verify Google ID tokens.
# This value is public, but must belong to the same Google Cloud project as
# GOOGLE_CLIENT_ID in kapor-backend/.env. Do not put a client secret here.
GOOGLE_SERVER_CLIENT_ID=

# Local development alternatives:
# Android emulator: http://10.0.2.2:8080/api
# iOS simulator: http://localhost:8080/api
