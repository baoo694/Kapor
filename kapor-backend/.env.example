# Copy this file to .env for local development, or set the same variables in
# your deployment environment. Never commit real credentials.
JWT_SECRET=replace-with-a-long-random-secret
GEMINI_API_KEY=
GEMINI_SUBTITLE_MAX_CONCURRENCY=3
GOOGLE_CLIENT_ID=
FIREBASE_ENABLED=false
# Host path used by docker-compose.fcm.yml to mount the key file.
FIREBASE_SERVICE_ACCOUNT_HOST_PATH=
# Path inside the API container to a mounted Firebase Admin service-account JSON file.
FIREBASE_SERVICE_ACCOUNT_FILE=
# Docker Compose loads this file directly into kapor-api. Do not duplicate
# these variables under the compose `environment:` block, or blank shell
# variables will override the values here.
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
OPENAI_API_KEY=
OPENAI_WHISPER_MODEL=
WHISPER_PROVIDER=

# WhisperX GPU batch size. Start with 4 on a 16 GB NVIDIA T4.
WHISPERX_GPU_BATCH_SIZE=4

# SMTP account used for transactional email.
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
