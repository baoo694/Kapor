# Copy this file to .env for local development, or set the same variables in
# your deployment environment. Never commit real credentials.
JWT_SECRET=replace-with-a-long-random-secret
GEMINI_API_KEY=
GEMINI_SUBTITLE_MAX_CONCURRENCY=3
GOOGLE_CLIENT_ID=
OPENAI_API_KEY=
OPENAI_WHISPER_MODEL=
WHISPER_PROVIDER=

# Used only with docker-compose.gpu.yml. Start with 4 on a 16 GB NVIDIA T4.
WHISPERX_GPU_BATCH_SIZE=4

# SMTP account used for transactional email.
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
