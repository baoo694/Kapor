# CUDA image for WhisperX inference on an NVIDIA GPU (for example, a GCE T4).
# CUDA 12.1 + cuDNN 8 is intentionally paired with CTranslate2 4.4 below.
FROM nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# ffmpeg handles WAV input.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    ffmpeg \
    patchelf \
    python3 \
    python3-dev \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .

# Install a CUDA-enabled PyTorch wheel before WhisperX resolves its dependencies.
# WhisperX 3.4.2 requires torch/torchaudio >= 2.5.1.
RUN python3 -m pip install --upgrade pip && \
    python3 -m pip install \
      --index-url https://download.pytorch.org/whl/cu121 \
      torch==2.5.1+cu121 \
      torchaudio==2.5.1+cu121 && \
    python3 -m pip install -r requirements.txt

# Google Compute Engine kernels can reject native libraries that request an
# executable stack. CTranslate2 is loaded by WhisperX at runtime, so clear the
# flag from its bundled shared libraries while building the image.
RUN set -eux; \
    site_packages="$(python3 -c 'import site; print(site.getsitepackages()[0])')"; \
    find "$site_packages" -type f -name 'libctranslate2*.so*' -print -quit | grep -q .; \
    find "$site_packages" -type f -name 'libctranslate2*.so*' -exec patchelf --clear-execstack {} \;

COPY main.py .

EXPOSE 8001

CMD ["python3", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8001"]
